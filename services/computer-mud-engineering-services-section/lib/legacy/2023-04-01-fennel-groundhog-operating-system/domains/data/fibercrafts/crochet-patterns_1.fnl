{:lotus-flower-blanket {:created-by "Hooked by Robin"
                        :source "https://www.hookedbyrobin.com/blog/2018/02/lotus-flower-blanket-free-crochet.html"
                        :notes ["There's a series of instructional videos at the source."]
                        :materials [[:yarn 1 :skein]]
                        :tools [:crotchet-hook]
                        :pattern [[:MR
                                   :ch3
                                   :11dc
                                   "Join with ss to top of ch3"]
                                  [:ch3
                                   "dc in same stitch"
                                   {11 [:inc]}
                                   "Join with ss to top of ch3"]]
                        :stitches [:double-crotchet
                                   :crotchet
                                   :increase]
