{:name "lower-sodium salt"
 :description "A blend meant to replace salt as seasoning."
 :prep-time [5 5]
 :servings 0
 :materials {:required [["celery salt" 4 :tsp]
                        ["powdered lemon peel" 1 :tsp]
                        ["corn starch" 2 :tsp]]}
