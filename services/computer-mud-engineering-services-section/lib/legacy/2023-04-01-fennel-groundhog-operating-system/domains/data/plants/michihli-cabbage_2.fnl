{:name "Michihli cabbage"
 :description "Sweet and crunchy Chinese cabbage popularized by Asian markets in the United States."
 :pronunciation "Mi-CHE-he-lee"
 :botanical-species "Brassica rapa Pekinensis"
 :names {:ingredient "Chinese cabbage"}
 :stages {:mature {:description "14in tall with 4in diameter heads."}}
 :gardening {:notes ["Best sown for fall harvest"]
             :days-to-sprout [3 12]
             :mature-spacing [12 18]
             :days-to-mature 70
             :days-to-flower 360
             :days-to-seed 420
             :planting {:seed-spacing [4 6]
                        :seed-depth 0.25}
             :seed-saving {:notes "Harvest when dry"
                           :isolation 0.5}}}

             
