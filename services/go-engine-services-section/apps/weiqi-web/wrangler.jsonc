{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weiqi-561-group",
  "compatibility_date": "2026-08-04",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    {
      "pattern": "weiqi.561.group",
      "custom_domain": true
    }
  ]
}
