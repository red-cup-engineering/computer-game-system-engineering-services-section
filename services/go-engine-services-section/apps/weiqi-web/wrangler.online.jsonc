{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weiqi-561-group",
  "main": "./src/match-worker.mjs",
  "compatibility_date": "2026-08-04",
  "assets": {
    "directory": "./public"
  },
  "durable_objects": {
    "bindings": [{ "name": "WEIQI_MATCHES", "class_name": "WeiqiMatchObject" }]
  },
  "migrations": [{ "tag": "v1", "new_classes": ["WeiqiMatchObject"] }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "routes": [
    { "pattern": "weiqi.561.group", "custom_domain": true }
  ]
}
